# Ascendant Ledger — environment configuration
# Copy before first run: cp .env.example .env

NODE_ENV=production
LOG_LEVEL=info
HOST_PORT=8080

# Keep 127.0.0.1 when a reverse proxy on this NAS will front the app.
# Set 0.0.0.0 for direct LAN access.
BIND_ADDRESS=127.0.0.1

DATABASE_FILENAME=ascendant-ledger.db

# ---------------------------------------------------------------------------
# Optional single-user authentication
# ---------------------------------------------------------------------------
# Leave false for a trusted private LAN installation. Turn on before exposing
# beyond a trusted LAN, and use HTTPS through a reverse proxy.
AUTH_ENABLED=false

# Required when AUTH_ENABLED=true. Generate with: openssl rand -base64 48
# SESSION_SECRET=

# Required only on FIRST BOOT of a new database with AUTH_ENABLED=true.
# The app hashes the password with scrypt and stores only the hash in SQLite.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-long-unique-password

# Set true only when a reverse proxy you control supplies X-Forwarded-* headers.
# This is important for Secure session cookies when TLS terminates at the proxy.
TRUST_PROXY=false

# Per-file limit and maximum files in one batch.
MAX_UPLOAD_BYTES=26214400
MAX_FILES_PER_BATCH=20

# Optional: existing SimCompanies Flask service. Keep its database separate.
# OPERATIONS_URL=http://host.docker.internal:5010
OPERATIONS_REALM=magnates
OPERATIONS_TIMEOUT_MS=30000
OPERATIONS_CONSOLE_PATH=/simcompanies-classic/

# Optional automatic import of saved captures for OPERATIONS_REALM only.
# The capture database must contain history for that single realm. Read-only access.
# OPERATIONS_DB_PATH="/path/to/capture-service/data/simcompanies.db"
CAPTURE_SYNC_INTERVAL_MS=60000
